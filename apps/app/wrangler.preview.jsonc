{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "signal-agent-preview-app",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "vars": { "ENVIRONMENT": "staging" }
}
