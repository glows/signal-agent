{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "signal-agent-preview-api",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": { "crons": [] },
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "vars": {
    "ENVIRONMENT": "staging",
    "APP_NAME": "Signal Agent",
    "APP_ORIGIN": "https://signal-agent-preview-web.ne0web64.workers.dev",
    "RESEND_EMAIL_FROM": "login@flymind.org"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_CACHED",
      "id": "b7287ec8729f49e681fc5633bc31f8c8"
    },
    {
      "binding": "HYPERDRIVE_UNCACHED",
      "id": "a0e9c226c9c7441687ea9f1388f426d2"
    }
  ],
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "RESEND_API_KEY"]
  }
}
